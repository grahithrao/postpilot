# ---------------------------------------------------------------------------
# PostPilot environment
# Copy to .env and fill in. The app runs fully in DEMO MODE with these defaults.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/postpilot_dev?schema=public"

# --- Auth -------------------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Encryption (OAuth tokens at rest, AES-256-GCM) -------------------------
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# --- AI ---------------------------------------------------------------------
# Leave AI_PROVIDER=mock (or omit keys) to run the built-in deterministic
# mock model. Set to "anthropic" or "openai" with a key for real generation.
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Demo mode --------------------------------------------------------------
# "true"  -> social publishing is simulated, analytics are generated
# "false" -> real platform adapters are used (requires OAuth credentials below)
DEMO_MODE="true"
# Probability (0-1) that a simulated publish fails, so retry/failure paths are demoable.
DEMO_PUBLISH_FAILURE_RATE="0.08"

# --- Scheduler --------------------------------------------------------------
# Secret required by POST /api/cron/tick (external cron / Vercel Cron).
CRON_SECRET="dev-cron-secret"
# Run the scheduler loop inside the Next.js process (great for local demos).
ENABLE_IN_PROCESS_SCHEDULER="true"
SCHEDULER_INTERVAL_MS="20000"

# --- Social OAuth (optional — DEMO MODE is used when absent) ----------------
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""
# INSTAGRAM_CLIENT_ID=""
# INSTAGRAM_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE_URL="http://localhost:3000"
